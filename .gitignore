# === Credentials and secrets ===
**/secrets.toml
streamlit/.streamlit/secrets.toml

# === Common junk ===
*.pyc
__pycache__/
.DS_Store
*.code-workspace
.env
.env.local
.env.*.local
.venv

# Isolated git worktrees created for background agent tasks
.claude/worktrees/


# === Exceptions (files we DO want to keep) ===
!.streamlit/secrets.toml.template
!.streamlit/README.md

# Local backup files (only used in local runs)
data/backups/

# Report-generation prompt hand-offs (plan-usage provider). Working files for a
# single run — the artefacts they produce live in data/commentary/.
data/llm_mailbox/

# Model-comparison / experiment output. Throwaway by design: promote the one you
# want into data/commentary/ (paths.promote_variant) and commit that instead.
data/commentary/variants/

# Pre-corrections backups written by authoring.apply_corrections. They exist so
# the pass is reversible without git; in the repo, git history already holds the
# text they preserve, so committing them is duplication.
data/commentary/*_precorrections.md
nul

#nodemodules -> what is this?
node_modules/
